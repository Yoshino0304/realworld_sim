<?xml version="1.0"?>
<sdf version="1.6">
  <world name="scaniverse_large_classroom_area">
    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://scaniverse_large_classroom_area</uri>
      <name>scaniverse_large_classroom_area</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <model name="top_down_camera">
      <static>true</static>
      <pose>0.44 0.72 32.0 0 1.57079632679 1.57079632679</pose>
      <link name="camera_link">
        <sensor name="top_down" type="camera">
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.22</horizontal_fov>
            <image>
              <width>1280</width>
              <height>960</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <plugin name="top_down_camera_controller" filename="libgazebo_ros_camera.so">
            <alwaysOn>true</alwaysOn>
            <updateRate>10</updateRate>
            <robotNamespace>/top_down</robotNamespace>
            <cameraName>camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>top_down_camera_link</frameName>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
